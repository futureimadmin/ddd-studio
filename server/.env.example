# Copy to server/.env — loaded automatically at startup (real environment variables win).
PORT=8080

# Where the workspace is persisted (default: ./data next to where the server is started)
# DDD_DATA_DIR=./data

# Gemini on Vertex AI via Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Force the offline "Studio Sketch" designer/codegen
# DDD_AI_OFFLINE=1

# Only needed if the UI is served from a different origin than the API
# CORS_ORIGIN=http://localhost:5173
